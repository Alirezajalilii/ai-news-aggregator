# =============================================================================
# AI News Aggregator - Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
HEALTHCHECK_PORT=8080

# ---- Database ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ai_news
DB_USERNAME=planchin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Port exposed on the host (avoid conflicts with other PostgreSQL instances)
DB_EXTERNAL_PORT=5433

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Port exposed on the host (avoid conflicts with other Redis instances)
REDIS_EXTERNAL_PORT=6381

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ---- Ollama (LLM Summarization) ----
# URL to Ollama API — use host.docker.internal to reach host from Docker
# Make sure Ollama listens on 0.0.0.0 (set OLLAMA_HOST=0.0.0.0 in systemd)
OLLAMA_BASE_URL=http://host.docker.internal:11434